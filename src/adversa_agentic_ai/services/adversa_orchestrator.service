[Unit]
Description=Adversa Orchestrator Service
After=network.target

[Service]
Type=simple
User=pals
WorkingDirectory=/home/pals/Workspace/adversa_agentic_ai
EnvironmentFile=/home/pals/Workspace/adversa_agentic_ai/.adversa_runtime_env
ExecStart=/home/pals/miniconda3/envs/cbsim/bin/python src/adversa_agentic_ai/agents/orchestrator/a3_orchestrator_main.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

